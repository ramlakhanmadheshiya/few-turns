; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Few Turns"
config/description="A quiet arrow puzzle."
config/version="1.0.0"
run/main_scene="res://game/scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(1, 0.956863, 0.909804, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/splash.png"
config/icon="res://assets/icon.svg"

[audio]

default_bus_layout="res://default_bus_layout.tres"

[autoload]

Events="*res://game/autoload/events.gd"
SaveSystem="*res://game/autoload/save_system.gd"
Haptics="*res://game/autoload/haptics.gd"
AudioManager="*res://game/autoload/audio_manager.gd"
Levels="*res://game/autoload/levels.gd"
Store="*res://game/autoload/store.gd"
WebPlatform="*res://game/autoload/web_platform.gd"
AdManager="*res://game/ads/ad_manager.gd"
ShareService="*res://game/autoload/share_service.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=495
window/size/window_height_override=880
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGooglePlayBilling/plugin.cfg", "res://addons/admob/plugin.cfg", "res://addons/fewturns_share/plugin.cfg")

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input]

restart={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":16,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":82,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":16,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
go={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":16,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(1, 0.956863, 0.909804, 1)
